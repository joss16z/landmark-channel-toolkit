# Copy to .streamlit/secrets.toml ONLY in the company-approved runtime.
# Deliberately disabled. These are contract placeholders, not an API response.
[arcanite]
enabled = false
contract_verified = false
account_scope = "agent_portal"
api_profile = "arcanite_landmark_v1"
project = "Hurstville Rise"
url = "https://service.arcnet.com.au/arc-service-api/v1/project/getProject"
method = "GET"
pagination = "VERIFY_COMPLETE_SINGLE_RESPONSE" # getProject paging is undocumented.
rows_path = "VERIFY_ROWS_PATH"
total_path = "VERIFY_COMPLETE_TOTAL_PATH"
# No property next-link field is assumed or configured by the official profile.
completeness = "VERIFY_total_field_OR_expected_lot_set"
project_context_verified = true # Owner-confirmed request project ID; response remains unverified.
# If the verified response has no total, use expected_lot_set only when the
# contract returns EVERY reviewed Lot, including unavailable properties.
# expected_lots = [<all owner-reviewed scoped Lots>]

[arcanite.headers]
# Add only the verified authentication header locally. Never commit its value.

[arcanite.query]
agencyid = "VERIFY_AGENCY_ID_LOCALLY"
sign = "VERIFY_API_KEY_LOCALLY" # Guide: fixed API key, not a computed signature.
projectid = "907440240"

[arcanite.fields]
# No property-level project field is assumed for this verified request context.
# Map an optional project field only if a real response supplies it.
lotnumber = "lotnumber"
propertystatus = "propertystatus"
unit = "unitnumber" # Owner-specified candidate; response validation pending.
bedrooms = "VERIFY_BEDROOM_CONFIGURATION_FIELD"
bathrooms = "VERIFY_BATHROOM_FIELD"
internal = "VERIFY_INTERNAL_AREA_FIELD"
external = "VERIFY_EXTERNAL_AREA_FIELD"
price = "price" # Owner-specified candidate; response validation pending.
